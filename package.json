{
  "name": "scrum-poker-fire",
  "version": "1.0.0",
  "description": "Scrum poker for your plannings. Powered by Firebase.",
  "author": "Thfona",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "ng serve --port 4500",
    "preview": "ng build --watch --configuration development",
    "build": "ng build --configuration development",
    "build:prod": "ng build --configuration production && node src/inject-metadata.js",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist && rimraf .angular",
    "clean:packages": "rimraf node_modules",
    "clean:all": "npm run clean && npm run clean:packages"
  },
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-locale": "^8.4.0",
    "@uiowa/digit-only": "^4.1.0",
    "firebase": "^12.18.0",
    "ngx-progressbar": "^14.0.0",
    "rxjs": "^7.8.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.31",
    "@angular-devkit/build-angular": "^21.2.31",
    "@angular/cli": "^21.2.31",
    "@angular/compiler-cli": "^21.2.26",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "firebase-tools": "^15.37.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
